generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../src/schema/zod"
}

model SystemSecret {
  key       String @id
  valueHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String                  @id @default(uuid())
  email         String?                 @unique
  role          String                  @default("viewer")
  displayName   String
  avatarPath    String?
  createdAt     DateTime                @default(now())
  readStatuses  UserVideoReadStatus[]
  identities    Identity[]
}

model Identity {
  id            String @id @default(uuid())
  userId        String
  provider      String
  providerUid   String
  secretHash    String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
}

model Video {
  id              String            @id @default(uuid())
  title           String
  folderKey       String
  scenePath       String?
  revisions       VideoRevision[]
  comments        VideoComment[]
  latestUpdatedAt DateTime          @default(now())
  deleted         Boolean           @default(false)

}

model VideoRevision {
  id          String   @id @default(uuid())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id])
  revision    Int
  filePath    String
  uploadedAt  DateTime @default(now())
  deleted     Boolean  @default(false)
  tags        String[] @default([])
  summary     String?

  analysisJob VideoAnalysisJob?
  processingJob VideoProcessingJob?

  @@unique([videoId, revision])
}

model VideoEventKind {
  id        String   @id @default(uuid())
  label     String   @unique
}

model PromptTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  prompt    String
  kinds     String[] @default([])
}

model VideoAnalysisJob {
  id              String              @id @default(uuid())
  videoRevisionId String              @unique
  status          JobStatus @default(pending)
  createdAt       DateTime            @default(now())

  videoRevision VideoRevision @relation(fields: [videoRevisionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model VideoProcessingJob {
  id              String   @id @default(uuid())
  videoRevisionId String  @unique
  status          JobStatus @default(pending)
  createdAt       DateTime @default(now())

  videoRevision VideoRevision @relation(fields: [videoRevisionId], references: [id], onDelete: Cascade)

  @@index([status])
}

model VideoComment {
  id                String          @id @default(uuid())
  video             Video           @relation(fields: [videoId], references: [id])
  videoId           String
  videoRevNum       Int     
  userName          String
  userEmail         String          @default("")
  comment           String         
  time              Float          
  issueId           String?        
  notifiedProviders String[]        @default([])
  drawingPath       String?        
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deleted           Boolean         @default(false)
  thumbsUp          Int             @default(0)
}

model SlackMessage {
  id              String         @id @default(uuid())
  channelId       String   
  ts              String   
  createdAt       DateTime       @default(now())
  videoCommentId  String?        @unique

  threadMessages SlackThreadMessage[]
}

model SlackThreadMessage {
  id              String   @id @default(uuid())
  slackMessage    SlackMessage @relation(fields: [slackMessageId], references: [id])
  slackMessageId  String

  ts              String
  createdAt       DateTime @default(now())
}

model UserVideoReadStatus {
  id                String   @id @default(uuid())
  userId            String?
  user              User?   @relation(fields: [userId], references: [id])

  videoId           String
  lastReadCommentId String?
  updatedAt         DateTime @updatedAt

  @@unique([userId, videoId])
}

model UploadSession {
  id          String   @id @default(uuid())
  storageKey String
  storage    UploadStorageType
  title      String
  folderKey  String
  scenePath  String?
  nextRev    Int
  createdAt  DateTime @default(now())
}

enum UploadStorageType {
  local
  s3
  nextCloud
}

enum JobStatus {
  pending
  running
  succeeded
  failed
}
