# =====================================================================
#  VideoReview - Environment Variables Example
# =====================================================================
#  Define all environment variables required for running VideoReview.
#  Only fill in what you need depending on which features you will use.
# =====================================================================


# ---------------------------------------------------------------------
#  Public settings used on the frontend (requires NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------

# The title displayed on the login screen and header.
NEXT_PUBLIC_VIDEO_REVIEW_TITLE="VideoReview"

# A short description shown on the login screen.
NEXT_PUBLIC_VIDEO_REVIEW_DESC="Internal Video Review Tool"

# Background image for the login screen.
# If empty, a solid black background will be used.
# Example: "/images/login-bg.jpg"
NEXT_PUBLIC_LOGIN_BG=""

# Example: "guest, jira, user"
NEXT_PUBLIC_LOGIN_DEFAULT_TYPE="guest"

# ---------------------------------------------------------------------
#  VideoReview
# ---------------------------------------------------------------------
# API token required for uploading videos via the upload API.
# Example: "supersecrettoken123"
VIDEO_REVIEW_API_TOKEN=""

#  VideoReview Maintenance Token (deprecated)
ADMIN_MAINTENANCE_TOKEN=""

# Custom URL scheme used to open external applications (e.g., Unity tools).
# Example: "videoreview://open?scene={scenePath}"
NEXT_PUBLIC_URL_SCHEMA=""

# Storage backend to use for uploaded video files.
# Options: "local" (local filesystem), "s3" (AWS S3), "nextCloud"
VIDEO_REVIEW_STORAGE="local"

# Local Storage Configuration
# Root directory within local for storing uploaded files.
LOCAL_ROOTDIR="/storage"

# ---------------------------------------------------------------------
#  JIRA integration
# ---------------------------------------------------------------------

# Base URL for linking to JIRA issues.
# Example: https://yourcompany.atlassian.net
JIRA_BASE_URL=""

# JIRA API Token (generate from your JIRA account settings).
JIRA_API_TOKEN=""

# JIRA project key to which new issues will be created.
# Example: "GAMEDEV"
JIRA_PROJECT=""

# User assigned automatically to newly created issues
# (JIRA email).
JIRA_ASSIGNEE_USER=""

# Issue types to show in the UI when creating JIRA issues.
# Example: "task" or "bug" (Issue Type name)
NEXT_PUBLIC_JIRA_ISSUE_TYPE_TASK=""
NEXT_PUBLIC_JIRA_ISSUE_TYPE_BUG=""

# ---------------------------------------------------------------------
#  Slack Notifications
# ---------------------------------------------------------------------

# Slack Bot User OAuth Token (begins with "xoxb-").
VIDEO_REVIEW_SLACK_API_TOKEN=""

# Slack channel name or channel ID where notifications will be posted.
# Example: "C00XXXXXX"
VIDEO_REVIEW_SLACK_POST_CH=""

# Slack Team Domain Name
# Once set up, you can jump to the posted post from VideoReview.
# Example: "Game.dev"
VIDEO_REVIEW_SLACK_TEAM=""

# ---------------------------------------------------------------------
#  Webhook Notifications
# ---------------------------------------------------------------------

# Example: slack, teams, ...
VIDEO_REVIEW_WEBHOOK_TARGET=""

# Example: slack: https://hooks.slack.com/services/....
# Example: teams: https://azure.com:443/workflows/xxxxxxxxxxxxxxxxxxxxxxx/triggers/....
VIDEO_REVIEW_WEBHOOK_URL=""

# ---------------------------------------------------------------------
#  Email Notifications
# ---------------------------------------------------------------------

# Enable or disable email notifications globally.
# When set to "false", no emails will be sent and SMTP will not be used.
# Default: false
VIDEO_REVIEW_EMAIL_ENABLE="false"

# SMTP server host used to send emails.
# Example:
#   localhost            (Docker / local SMTP relay)
#   mail.internal.local  (internal SMTP server)
VIDEO_REVIEW_SMTP_HOST="localhost"

# SMTP server port.
# Common values:
#   25    : internal SMTP relay (no TLS)
#   1025  : local development (e.g. Docker Postfix)
#   587   : authenticated SMTP with STARTTLS
VIDEO_REVIEW_SMTP_PORT="1025"

# Sender email address used for all notifications.
# This should be a valid address accepted by the SMTP relay.
# Example:
#   noreply@videoreview.local
#   noreply@example.com
VIDEO_REVIEW_EMAIL_FROM="noreply@videoreview.local"

# ---------------------------------------------------------------------
#  Database
# ---------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Example: "postgresql://user:password@localhost:5432/videoreview"
DATABASE_URL="postgresql://user:password@localhost:5432/videoreview"

# ---------------------------------------------------------------------
#  AWS
# ---------------------------------------------------------------------

# AWS S3 Bucket name for storing uploaded files.
# Example: "videoreview-bucket"
S3_BUCKET="videoreview-bucket"

# AWS S3 Region.
# Example: "us-east-1"
S3_REGION=""

# AWS S3 LocalStack endpoint (for local development).
# Leave empty when not using LocalStack.
# Example: "http://localstack:4566"
S3_LOCALSTACK_ENDPOINT=""

#  AWS Credentials
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# =====================================================================
# nextCloud Storage Configuration
# =====================================================================
# Base URL of the nextCloud/OwnCloud instance (e.g., "https://cloud.yourcompany.com/nextcloud").
NEXTCLOUD_BASE_URL=""

# Username for nextCloud/OwnCloud authentication.
NEXTCLOUD_USERNAME=""

# Password or App Password for nextCloud/OwnCloud authentication.
NEXTCLOUD_PASSWORD=""

# Root directory within nextCloud for storing uploaded files.
NEXTCLOUD_ROOTDIR=""

# ---------------------------------------------------------------------
#  JWT Authentication (deprecated)
# ---------------------------------------------------------------------

# Secret key used to sign JWT tokens.
# Use a long, random string.
# Example: "supersecretstring123"
JWT_SECRET=""