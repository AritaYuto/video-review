# Local test environment variables (for `npm run test:*:local`)
# Copy this file to `.env.test` and adjust values for your machine.
# `npm run test` / `npm run test:hono` will reset this database each time.

DATABASE_URL="postgresql://user:password@localhost:5432/videoreview_test"
VIDEO_REVIEW_LOCAL_ROOTDIR="/tmp/videoreview-test-uploads"

# Optional defaults to avoid missing-env behavior in some modules.
VIDEO_REVIEW_STORAGE="local"
NODE_ENV="test"
